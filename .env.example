# ==============================================================================
# Somnia - Environment Configuration Example
# ==============================================================================

# OpenRouter API Key (Required for submitting batches)
# You can also set/change this key anytime in the Web UI Settings dialog.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Persistent storage directory (defaults to /app/data in Docker, or ./data locally)
DATA_DIR=/app/data

# Background polling interval in minutes (defaults to 5 minutes)
POLL_INTERVAL_MINUTES=5

# TrueNAS Scale / Linux User & Group permissions (default 1000:1000)
PUID=1000
PGID=1000

# Server Port
PORT=8000
